# Copie para .env.local (dev) e preencha com os valores do projeto Supabase.
# Nunca commitar .env.local / .env.production — ver docs/06-seguranca.md.

# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel Supabase > Project Settings > API > service_role (secreta — só server-side)
SUPABASE_SERVICE_ROLE_KEY=

# Painel Supabase > Project Settings > Database > Connection string (URI, modo "Transaction")
# Usada pelo Drizzle (drizzle-kit e o client em src/lib/db/client.ts).
DATABASE_URL=
