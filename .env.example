# Copie para .env.local (dev) e preencha com os valores do projeto Supabase.
# Nunca commitar .env.local / .env.production — ver docs/06-seguranca.md.

# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel Supabase > Project Settings > API > service_role (secreta — só server-side)
SUPABASE_SERVICE_ROLE_KEY=

# Painel Supabase > Project Settings > Database > Connection string (URI, modo "Transaction")
# Usada pelo Drizzle (drizzle-kit e o client em src/lib/db/client.ts).
DATABASE_URL=

# URL pública do app (sem barra no final) — base dos links enviados por
# e-mail (confirmação de cadastro, redefinição de senha). Em dev pode ficar
# vazia: usa o host do request.
APP_URL=

# ---------------------------------------------------------------------------
# Asaas (pagamentos) — sem mensalidade, só taxa por transação.
# Sem ASAAS_API_KEY/ASAAS_PLAN_VALUE o checkout usa o link fixo configurado
# no painel master (app_settings.asaas_checkout_url) com liberação manual.
# ---------------------------------------------------------------------------
# Painel Asaas > Integrações > Chave de API
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Mensalidade em reais, ponto decimal (ex. 29.90)
ASAAS_PLAN_VALUE=
ASAAS_PLAN_DESCRIPTION=
# Painel Asaas > Integrações > Webhooks > "Token de autenticação" (o mesmo
# valor nos dois lados). URL do webhook: <APP_URL>/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Google Calendar (lembretes) — Calendar API é gratuita na cota padrão.
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth
# (Aplicativo da Web). URI de redirecionamento autorizado:
#   <APP_URL>/api/integrations/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes em base64 — cifra o refresh token no banco (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
